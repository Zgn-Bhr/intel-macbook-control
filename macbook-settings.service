[Unit]
Description=Re-apply MacBook Control's battery charge limit and keyboard options
Documentation=file:///usr/local/bin/macbook-settings
After=systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 -I /usr/local/bin/macbook-settings apply
# It only reads its settings file and writes a few files in /sys
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
