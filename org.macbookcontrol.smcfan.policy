<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>MacBook Control</vendor>
  <!-- Lets MacBook Control run "smcfan set ..." as root. smcfan itself refuses every other
       command when started through pkexec, and validates the mode before writing it. -->
  <action id="org.macbookcontrol.smcfan.set">
    <description>Change the MacBook fan mode</description>
    <message>Authentication is required to change the fan mode</message>
    <icon_name>computer-laptop</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/smcfan</annotate>
  </action>
</policyconfig>
