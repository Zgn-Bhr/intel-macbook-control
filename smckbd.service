[Unit]
Description=Keyboard backlight for KDE/UPower on the macsmc driver (smc::kbd_backlight)
Documentation=file:///usr/local/bin/smckbd
# Started by 90-smcfan.rules when /dev/smc appears; stops if it goes away
BindsTo=dev-smc.device
After=dev-smc.device
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
ExecStartPre=/usr/bin/modprobe uleds
ExecStart=/usr/bin/python3 -I /usr/local/bin/smckbd
Restart=on-failure
RestartSec=5
# It only needs /dev/uleds and the two LEDs' brightness files in /sys
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=char-misc rw
